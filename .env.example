# ─────────────────────────────────────────────────────────────
# Cofrinho — variáveis de ambiente (MODELO, sem valores reais)
# 1. Copie este arquivo para .env
# 2. Preencha os valores no .env (ele NÃO vai para o GitHub)
# 3. Na Vercel: Settings → Environment Variables, mesmas chaves
#
# Regra: só o que começa com NEXT_PUBLIC_ vai para o navegador.
# Chaves secretas ficam SEM esse prefixo e só rodam no servidor.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# false = só estágio 1 (sem Fatura e Assistente)
NEXT_PUBLIC_PLUS=true
# false = Fatura e Assistente simulados no front (padrão)
# true  = usam as rotas /api/fatura e /api/assistente (precisa da OPENAI_API_KEY)
NEXT_PUBLIC_USE_API=false

# ── Supabase ─────────────────────────────────────────────────
# Público (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETO — só servidor. Nunca use no front.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (estágio 2) ───────────────────────────────────────
# SECRETO — só servidor. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
